{
  "name": "dispatcharr-e2e",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "test": "echo 'Pick a population: npm run test:pristine | test:seeded | test:streaming — they need different container states and cannot share one invocation.' && exit 1",
    "test:pristine": "playwright test --project=pristine",
    "test:seeded": "playwright test --project=seeded",
    "test:streaming": "playwright test --project=streaming",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
