{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/run-affected-tests.sh\"",
            "timeout": 300,
            "statusMessage": "Running tests for the edited file"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/pre-commit-tests.sh\"",
            "timeout": 600,
            "statusMessage": "Running tests for the staged changes"
          }
        ]
      }
    ]
  }
}
